# Per-agent settings for the familiarise skill. Copy to .env beside SKILL.md and set the paths.
# Installed .env files are never shipped; each agent has its own.

# The shared-memory skill directory for this agent (the one that holds scripts/memory_bridge.py).
SHARED_MEMORY_SKILL_DIR=~/.claude/skills/shared-memory

# One token file per framework: .env-<host>, where <host> is the ssh alias the tunnel uses.
# Per agent: inside this agent's own familiarise skill directory. Never a shared folder, so no agent reads another's tokens.
FRAMEWORK_ENV_DIR=~/.claude/skills/familiarise/frameworks

# A local label only. The gateway sets identity from the token, so leave this blank unless you want the mismatch warning.
AGENT_NAME=
